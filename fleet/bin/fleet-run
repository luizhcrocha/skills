#!/bin/sh
# Stub: the fleet left tstack. Sessions on older tstack versions hand over to the newest tstack's fleet/bin/fleet-run,
# which runs the fleet repo's apps/cli: its plugin's marketplace clone, the office's fleet-live, else the fleet-run on PATH.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
if [ -n "${FLEET_TSTACK_STUB:-}" ]; then
  echo 'fleet-run: the fleet-run on PATH runs this tstack stub again; point it at the fleet repo'"'"'s apps/cli' >&2
  exit 127
fi
for cand in "$HOME/.claude/plugins/marketplaces/fleet/apps/cli/bin/fleet-run" "$HOME/repos/luizhcrocha/fleet-live/apps/cli/bin/fleet-run"; do
  [ -f "$cand" ] && [ -x "$cand" ] && exec "$cand" "$@"
done
oldifs=$IFS
IFS=:
for dir in $PATH; do
  cand=${dir:-.}/fleet-run
  [ -f "$cand" ] && [ -x "$cand" ] || continue
  [ "$(readlink -f "$cand" 2>/dev/null || echo "$cand")" = "$self" ] && continue
  IFS=$oldifs
  FLEET_TSTACK_STUB=1 exec "$cand" "$@"
done
IFS=$oldifs
echo 'fleet moved to the fleet plugin: run `fleet agent install`' >&2
exit 127
