#!/usr/bin/env python3
"""tstack's hook dispatcher as hooks.json starts it, `tstack-hook <Event>`; its code is hooks/tstack-hook.py.

This launcher loads that file as a module, so Python keeps its bytecode in hooks/__pycache__: a script run directly
is compiled from source on every call, and for this one that was most of a hook's cost (2026-10-15, a SessionStart
in a jj repo, best of 18: 157 ms of CPU run as a script, 73 ms through this launcher). Where the folder cannot be
written, Python skips the cache and compiles as before. A load that fails is logged, named on stderr and exits 1.
"""

import os
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import cache_from_source, module_from_spec, spec_from_loader


def load():
    """The dispatcher as a module, from its cached bytecode. A cache Python cannot read (a .pyc cut short after a
    valid header raises outside the loader's own fallback, on every run after) is removed, and the module is compiled
    from source this once; the next run caches it again."""
    code = os.path.join(os.path.dirname(os.path.realpath(__file__)), "tstack-hook.py")
    loader = SourceFileLoader("tstack_hook", code)
    module = module_from_spec(spec_from_loader(loader.name, loader))
    try:
        loader.exec_module(module)
    except Exception:  # noqa: BLE001 - whatever the cache did, the source decides
        try:
            os.remove(cache_from_source(code))
        except OSError:
            pass
        module = module_from_spec(spec_from_loader(loader.name, loader))
        exec(compile(loader.get_data(code), code, "exec"), module.__dict__)
    return module


def fail(env):
    """What the dispatcher's own log() does, without the dispatcher, and one line on stderr: exit 1 is a hook error
    the user sees that blocks nothing (2 would block), as a script that failed to compile showed it before."""
    import time
    import traceback
    state = env.get("XDG_STATE_HOME") or os.path.join(env.get("HOME", "/tmp"), ".local", "state")
    data_dir = env.get("CLAUDE_PLUGIN_DATA") or os.path.join(state, "tstack")
    path = os.path.join(data_dir, "hook.log")
    try:
        os.makedirs(data_dir, exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} launcher failed to load the dispatcher\n"
                    f"{traceback.format_exc().rstrip()}\n")
    except OSError:
        pass
    print(f"tstack-hook: dispatcher failed to load, see {path}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        hook = load()
    except BaseException:  # noqa: BLE001 - logged and shown, never a blocking error
        sys.exit(fail(os.environ))
    sys.exit(hook.main(sys.argv, sys.stdin, sys.stdout, os.environ))
