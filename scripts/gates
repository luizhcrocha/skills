#!/usr/bin/env python3
"""Run the repo's test suites in parallel: all of them, or the ones a change touches.

    gates all [--jobs N]                     every suite `just test` names
    gates changed [REVSET] [--jobs N] [--dry-run]
                                             the suites whose inputs changed in REVSET
                                             (default master@origin..@, the stack), from SCOPE
    gates plan PATH...                       the suites PATH... would run, and why; runs nothing

A suite is a just recipe (`just --no-deps test-page`). The installs the suites share run once,
first, one per directory (`_deps-lint` is lint/ts's bun install, which test-lint-ts, test-fleet-ts-own
and test-page would otherwise run at the same time in one node_modules), then the suites run
concurrently, longest first. Each suite's output is printed whole when it ends, under its
PASS/FAIL line and duration, and a summary closes the run. Exit 1 when any suite or install
failed. Every suite already works in throwaway temp dirs and ephemeral ports, so they share
nothing else. Stdlib only.

A suite that outlives its wall-clock limit is killed, process group and all, and reported as FAIL
with "timed out after Ns" and the last lines of its output, so a hung worker fails the gate instead
of holding it. `bun test` has no such limit of its own: its --timeout (default 5000 ms) is per test,
and a hung --parallel worker process is outside any test. The limit is LIMITS[suite], about three times the
suite's normal time, or one number for every suite: `--timeout SECONDS` or $GATES_TIMEOUT.
"""
import argparse
import fnmatch
import os
import signal
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DEFAULT_REVSET = "master@origin..@"

# The suites, longest first (the order they start in), with the installs each needs. A suite is the just
# recipe that runs it: `just <suite>` reruns one alone. The TypeScript fleet's recipe is two here, its own
# checks and the oracle against it, so they overlap instead of queueing.
FLEET_TS = ("test-fleet-ts-own", "test-fleet-ts-oracle")
SUITES = {
    "test-scripts": (),
    "test-coordinator": (),
    "test-fleet-ts-own": ("_deps-fleet", "_deps-lint"),
    "test-fleet-ts-oracle": ("_deps-fleet",),
    "test-page": ("_deps-page", "_deps-lint"),
    "test-fleet": (),
    "test-lint-ts": ("_deps-lint",),
    "test-coordinator-page": (),  # page.test.mjs alone; test-coordinator runs it too
    "validate": (),
}
# Wall-clock limit per suite in seconds: about 3x its normal time, under the parallel gate's load.
DEFAULT_LIMIT = 900
LIMITS = {
    "test-scripts": 600,
    "test-coordinator": 300,
    "test-fleet-ts-own": 600,
    "test-fleet-ts-oracle": 600,
    "test-page": 900,
    "test-fleet": 600,
    "test-lint-ts": 600,
    "test-coordinator-page": 300,
    "validate": 300,
    "_deps-fleet": 600,
    "_deps-lint": 600,
    "_deps-page": 600,
}
TAIL_LINES = 25
FULL = tuple(s for s in SUITES if s not in ("test-coordinator-page", "validate"))  # `just test`
EVERYTHING = FULL + ("validate",)

# Path pattern -> suites, and why. The first pattern a path matches decides; `*` crosses `/`.
# A path no pattern matches runs EVERYTHING.
SCOPE = (
    ("skills/productivity/coordinator/assets/dashboard.html", ("test-page", "test-coordinator-page", "test-fleet"),
     "the built page: test-page checks it against a fresh build, page.test.mjs reads it, the oracle renders through it"),
    ("skills/productivity/coordinator/assets/*", ("test-coordinator", "test-fleet", *FLEET_TS),
     "the templates both fleets copy into a dashboard dir (brief.md, standing.md)"),
    ("skills/productivity/coordinator/scripts/*", ("test-coordinator", "test-fleet"),
     "the Python fleet: its tests, and the oracle that replays the traces on it"),
    ("skills/productivity/coordinator/tests/page.test.mjs", ("test-coordinator-page",), "the page's node tests"),
    ("skills/productivity/coordinator/tests/*", ("test-coordinator",), "the Python fleet's tests"),
    ("skills/*", ("test-scripts", "validate"),
     "skill content: test-scripts checks skill links, sources tables, model and effort pairs and the skills' own scripts"),
    ("agents/*", ("test-scripts", "validate"), "the agent definitions: test-scripts checks their model and effort"),
    ("*.md", ("validate",), "prose no test reads"),
    ("fleet/page/*", ("test-page", "test-coordinator-page"), "the page's source"),
    ("fleet/src/ledger/link-kind.ts", ("test-page", "test-coordinator-page", *FLEET_TS, "test-fleet"),
     "the link kinds the page bundles as well as the fleet"),
    ("fleet/oracle/*", ("test-fleet", *FLEET_TS[1:]), "the oracle runs against both fleets"),
    ("fleet/*", (*FLEET_TS, "test-fleet"), "the TypeScript fleet, and the oracle against both"),
    ("lint/*", ("test-lint-ts", "test-fleet-ts-own", "test-page", "test-scripts"),
     "the lint packs every TypeScript suite runs, and the registry test-scripts checks"),
    ("scripts/*", ("test-scripts",), "the repo scripts"),
    ("bin/*", ("test-scripts",), "the scripts' wrappers"),
    ("hooks/*", ("test-scripts",), "the plugin hook"),
    (".claude-plugin/*", ("validate", "test-scripts"), "the manifests, and the skill list test-scripts reads"),
)


def choose(paths: list[str]) -> dict[str, list[str]]:
    """The suites to run for these changed paths: suite -> the reasons, in EVERYTHING's order."""
    chosen: dict[str, list[str]] = {}
    for path in paths:
        for pattern, suites, why in SCOPE:
            if fnmatch.fnmatchcase(path, pattern):
                break
        else:
            pattern, suites, why = None, EVERYTHING, "no pattern matches it, so everything runs"
        for suite in suites:
            chosen.setdefault(suite, []).append(f"{path} ({why})" if pattern is None else f"{path} [{pattern}]: {why}")
    if "test-coordinator" in chosen and "test-coordinator-page" in chosen:
        chosen["test-coordinator"] += chosen.pop("test-coordinator-page")
    return {s: chosen[s] for s in SUITES if s in chosen}


def changed_paths(revset: str) -> list[str]:
    done = subprocess.run(["jj", "diff", "--name-only", "-r", revset], cwd=REPO, capture_output=True, text=True)
    if done.returncode != 0:
        sys.exit(f"gates: jj diff --name-only -r {revset!r} failed:\n{done.stderr}")
    return [line for line in done.stdout.splitlines() if line]


# -- running -------------------------------------------------------------------------------------
_print_lock = threading.Lock()
TIMED_OUT = 124  # timeout(1)'s exit code


TERM_GRACE = 10.0  # seconds a timed-out group has to clean up after SIGTERM before SIGKILL


def _kill_group(proc: subprocess.Popen, grace: float = 0.0) -> None:
    """SIGTERM the group and wait up to `grace` s for it to empty (zombies of an unreaped leader count as gone),
    then SIGKILL what is left."""
    if grace > 0:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            proc.poll()
            try:
                os.killpg(proc.pid, 0)
            except ProcessLookupError:
                return
            time.sleep(0.05)
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def run_limited(argv: list[str], limit: float, cwd: Path | None = None) -> tuple[int, bool, float, str]:
    """Run argv in its own process group; on `limit` seconds stop the whole group: SIGTERM, then SIGKILL after TERM_GRACE seconds.

    Returns (exit code, timed out, seconds, output). The output is read as it comes, so what a hung
    suite printed before it hung survives the kill.
    """
    start = time.monotonic()
    # A suite runs this checkout's fleet, never the newest tstack elsewhere on the machine.
    proc = subprocess.Popen(argv, cwd=cwd or REPO, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, start_new_session=True, env={**os.environ, "FLEET_NO_FORWARD": "1"})
    chunks: list[bytes] = []
    reader = threading.Thread(target=lambda: [chunks.append(c) for c in iter(lambda: proc.stdout.read1(65536), b"")],
                              daemon=True)
    reader.start()
    timed_out = False
    try:
        proc.wait(timeout=limit)
    except subprocess.TimeoutExpired:
        timed_out = True
    _kill_group(proc, TERM_GRACE if timed_out else 0.0)  # also reaps what the suite left behind when it exited on its own
    proc.wait()
    reader.join(5)
    proc.stdout.close()
    return proc.returncode, timed_out, time.monotonic() - start, b"".join(chunks).decode("utf-8", "replace")


def _limit(recipe: str, override: float | None) -> float:
    return override if override is not None else LIMITS.get(recipe, DEFAULT_LIMIT)


def _run(recipe: str, override: float | None = None) -> tuple[str, int, float, str]:
    limit = _limit(recipe, override)
    code, timed_out, secs, out = run_limited(["just", "--no-deps", recipe], limit)
    if timed_out:
        lines = out.splitlines()[-TAIL_LINES:]
        out = (f"gates: {recipe} timed out after {limit:g}s; its process group was killed. "
               f"Last {len(lines)} line(s) of its output:\n" + "\n".join(lines) + "\n")
        code = TIMED_OUT
    return recipe, code, secs, out


def _report(recipe: str, code: int, secs: float, out: str) -> None:
    verdict = "PASS" if code == 0 else f"FAIL (timed out after {secs:.0f}s)" if code == TIMED_OUT else f"FAIL (exit {code})"
    with _print_lock:
        print(f"\n===== {recipe}: {verdict} in {secs:.1f}s =====", flush=True)
        sys.stdout.write(out if out.endswith("\n") or not out else out + "\n")
        print(f"===== end {recipe}: {verdict} =====", flush=True)


def run(suites: list[str], jobs: int, timeout: float | None = None) -> int:
    t0 = time.monotonic()
    results: dict[str, tuple[int, float]] = {}
    deps = list(dict.fromkeys(d for s in suites for d in SUITES[s]))
    if deps:
        with ThreadPoolExecutor(len(deps)) as pool:
            for recipe, code, secs, out in pool.map(lambda d: _run(d, timeout), deps):
                if code != 0:
                    _report(recipe, code, secs, out)
                results[recipe] = (code, secs)
    if any(code for code, _ in results.values()):
        print("gates: an install failed; no suite ran", file=sys.stderr)
        return 1
    print(f"gates: running {', '.join(suites)} ({min(jobs, len(suites))} at a time)", flush=True)
    with ThreadPoolExecutor(max(1, jobs)) as pool:
        for fut in as_completed([pool.submit(_run, s, timeout) for s in suites]):
            recipe, code, secs, out = fut.result()
            _report(recipe, code, secs, out)
            results[recipe] = (code, secs)
    print(f"\n===== summary ({time.monotonic() - t0:.1f}s wall) =====")
    for recipe in [*deps, *suites]:
        code, secs = results[recipe]
        verdict = "PASS" if code == 0 else "FAIL"
        print(f"  {verdict}  {recipe:<22} {secs:6.1f}s")
    return 1 if any(code for code, _ in results.values()) else 0


def default_jobs() -> int:
    """Every suite at once on a big machine; the heavy two (Chromium, the oracle) set the floor."""
    return max(2, min(len(SUITES), (os.cpu_count() or 4) // 4))


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("all")
    c = sub.add_parser("changed")
    c.add_argument("revset", nargs="?", default=DEFAULT_REVSET)
    c.add_argument("--dry-run", action="store_true", help="print the choice and run nothing")
    for s in (a, c):
        s.add_argument("--jobs", type=int, default=default_jobs())
        s.add_argument("--timeout", type=float, default=float(os.environ["GATES_TIMEOUT"]) if "GATES_TIMEOUT" in os.environ else None,
                       metavar="SECONDS", help="wall-clock limit for every suite and install (default: LIMITS per suite; $GATES_TIMEOUT)")
    pl = sub.add_parser("plan")
    pl.add_argument("paths", nargs="+")
    args = p.parse_args(argv)

    if args.cmd == "all":
        return run(list(FULL), args.jobs, args.timeout)
    paths = changed_paths(args.revset) if args.cmd == "changed" else args.paths
    if not paths:
        print(f"gates: nothing changed in {args.revset}; nothing to run")
        return 0
    chosen = choose(paths)
    print(f"gates: {len(paths)} changed path(s) choose {', '.join(chosen)}")
    for suite, why in chosen.items():
        print(f"  {suite}")
        for reason in why[:5]:
            print(f"    {reason}")
        if len(why) > 5:
            print(f"    … and {len(why) - 5} more")
    if args.cmd == "plan" or args.dry_run:
        return 0
    return run(list(chosen), args.jobs, args.timeout)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
