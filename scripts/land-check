#!/usr/bin/env python3
"""Land's verdict on one push: may it go without asking?

    land-check --bookmark B [--head REV] [--remote origin] [--apply-skip-ci | --pre-gate]
               [--require-reviews] [--push-token T]
    land-check --interdiff CHANGE@COMMIT [--to CHANGE]
    land-check --fingerprint REV

Prints JSON. Run it after `jj git fetch` and the rebase, from inside the
workspace. Exit 0 when the verdict is "push", 1 for "ask" or "stop", 2 on error.

    bookmark, remote   what is being landed, and where
    head               the single top revision of the work under @ (--head
                       overrides); several heads → verdict "stop"
    ff                 B@remote is an ancestor of head (and the local B too):
                       the push only adds commits
    stack              B@remote..head, bottom first
    files              every path the push changes
    deploys_on_push    true | false | "unknown": does a push of these files to
                       B deploy? From .github/workflows (push triggers, branch
                       and path filters, jobs that deploy, workflow_run chains),
                       other CI configs, and, when no workflow deploys, platform
                       configs (wrangler, netlify, vercel...) and the repo's
                       docs, either of which makes it "unknown"
    skip_ci_habit      the last 30 trunk subjects, the workflows or the docs
                       use [skip ci]
    skip_ci_marked     head's message already carries it
    suggest_skip_ci    the habit holds, head lacks the marker, and every file
                       is docs, a memo note (.tstack/), tooling or a test
    verdict            "push": fast-forward, and nothing deploys (or [skip ci]
                       on the head stops the only deploys, GitHub Actions ones);
                       "ask": the push would deploy, or nobody can tell;
                       "stop": not a fast-forward, several heads, nothing to
                       push, or a revision jj would refuse to push
    gate_needed        false when every file is a Markdown file, LICENSE or
                       CODEOWNERS at the root, a .md or .txt file in the
                       top-level docs/, doc/, adr/ or adrs/, a memo note
                       (.tstack/memo/) or a review record (.tstack/reviews/
                       *.tsv): the stack fast-forwards without a gate run. A
                       README or docs folder among code, .mdx, .rst, a
                       requirements.txt, tests and tooling keep it true
    reasons            one line per finding behind the verdict
    turn               in a fleet whose machine serves a manager, why this fleet
                       may not land yet (`fleet turn`): the manager has not given
                       it the landing turn. The verdict is then "stop"
    freeze             the landings of this repository (its jj store) that hold the
                       machine's gate for another workspace: a landing gate
                       running, or one that passed and keeps the landing turn
                       for its push (fleet, what, pushing, until, ends). A push
                       now would move the tip that landing proved, and it would
                       gate again, so the verdict is "stop" until it has pushed
                       or ended. A hold whose workspace is this one, whose token
                       is --push-token, or whose run (the gate's runs.jsonl) ran
                       here is this lane's own and freezes nothing
    review             whether the stack needs a review before landing (the
                       coordinator's Integrate rule): `lines` changed (lockfiles
                       and generated files left out), the `sensitive` paths or
                       lines (a schema or migration, auth or permissions, a
                       deletion of data, billing), `needed`, `bug_hunt` (over
                       2,000 lines), the fleet `ledger` read, and the stack's
                       changes: `reviewed` (a `reviewed` event read the change's
                       current content), `unreviewed` (no event names it),
                       `changed_after_review` (the latest review read other
                       content), and `inferred` (the event names no commit). A
                       review covers the commit it read, `change@commit` in the
                       event: `jj interdiff --from <that commit> --to <the
                       change's commit now>` must be empty, so a pure rebase
                       passes and a fold squashed in after the review does not.
                       The commit must be 8 or more hex digits and one jj
                       evolog shows for the change, else the review counts for
                       nothing. An event with a bare change id (recorded before
                       reviews named commits) is taken at the latest commit `jj
                       evolog` shows for the change before the event's second
                       (one in that second counts as after it), and fails when
                       evolog has none from before it. Never changes the
                       verdict: a stack that needs a review and has no review of
                       a change's current content gets a "warning:" reason, and
                       one with no ledger and no review record to read a
                       "reminder:" reason. The repo's review records count as
                       `reviewed` events do (`records`: how many)
    reviews            per change of the stack (one touching only .tstack/ left
                       out), what review it still needs: {change, state, since,
                       at, reviewer, interdiff}. "current": a review read its
                       content (its commit, or one whose interdiff to it is
                       empty: a rebase, or a record whose patch fingerprint is
                       its own), nothing to review; "interdiff": a
                       review read an older commit, `since`, and only the
                       interdiff since (`land-check --interdiff change@since`)
                       needs reading; "missing": no review, or none naming one
                       of its commits (`why`), so its full diff does. Reviews
                       come from the fleet ledger's `reviewed` events and the
                       repo's records, .tstack/reviews/<change>.tsv committed in
                       the change itself (a record is left out of every
                       interdiff), one row per fresh review:
                       change@commit TAB at (RFC 3339) TAB reviewer (model) TAB
                       verdict TAB note TAB patch (`--fingerprint`; older rows
                       have none and are read by their commit alone). Only the
                       stack's changes' records are read. Report only, unless
                       --require-reviews

--ledger DIR names the fleet's dashboard directory; else $FLEET_DIR, else the
fleet whose registry entry's pid is among this process's parents.

--require-reviews makes a change with state "missing" or "interdiff" a
"warning:" reason and the verdict "stop" (with --pre-gate, exit 1): the remedy
is the lane's own review, not Luiz's yes.

--push-token T names the token this lane's passed `gate run --landing` printed,
when its push hold does not name this workspace.

--apply-skip-ci appends " [skip ci]" to head's subject when suggest_skip_ci
holds (idempotent, head only), then reports on the rewritten head.

--pre-gate runs before the full gate takes the slot (Land's step 5,
`land-check --pre-gate -b B && fleet fleets gate run ...`): the same JSON, no
landing turn asked and nothing rewritten, and the exit code says whether the
gate may start: 1 when the stack needs a review the ledger does not record,
or a change changed after its review (the "warning:" reasons), or there is no
single head with work to push (its
reason on stderr), 0 otherwise, 2 on error.

--interdiff CHANGE@COMMIT prints `jj interdiff --git --from COMMIT --to CHANGE`
(--to names the change a reshape made of CHANGE, when its id changed) and says
on stderr whether it is empty: exit 0 when it is (a pure rebase or reshape: the
review may be re-recorded at the new change@commit), 1 when not (review it
again), 2 when COMMIT is not one of CHANGE's commits or jj cannot compare them.
No bookmark, ledger or verdict.

--fingerprint REV prints REV's patch fingerprint, a review record's patch
column: the first 16 hex digits of the sha256 of `jj diff --git -r REV` with
the review records left out, cut to its file headers, mode and rename lines and
its added and removed lines (no index line, hunk header or context line). It is
the same on any clone and across a rebase that leaves the patch alone, so a
record whose fingerprint is the change's reads "current" where jj evolog does
not show the commit it names (another clone, a collected evolog).
"""

import argparse
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

LANDING_REMOTE = "origin"  # the remote a landing goes to, unless --remote says another
SKIP_MARKERS = ("[skip ci]", "[ci skip]", "[no ci]", "[skip actions]", "[actions skip]")
HABIT_SAMPLE = 30

NON_DEPLOYING = {
    "docs": ["**/*.md", "**/*.mdx", "**/*.rst", "docs/**", "doc/**", "LICENSE*", "CODEOWNERS",
             ".github/ISSUE_TEMPLATE/**", ".github/PULL_REQUEST_TEMPLATE*"],
    "memo": [".tstack/**"],
    "tests": ["**/tests/**", "**/test/**", "**/__tests__/**", "**/testdata/**", "**/*_test.*",
              "**/test_*.py", "**/*.test.*", "**/*.spec.*", "**/conftest.py"],
    "tooling": ["justfile", ".justfile", "Justfile", ".editorconfig", ".gitignore", ".gitattributes",
                ".claude/**", ".vscode/**", ".serena/**", ".envrc", "devenv.nix", "devenv.yaml", "devenv.lock",
                ".pre-commit-config.yaml", ".prettierrc*", ".prettierignore", ".markdownlint*"],
}

DEPLOY_WORDS = re.compile(
    r"deploy|\bpublish|\brelease\b|wrangler|vercel|netlify|flyctl|superfly|gh-pages|pages-artifact"
    r"|firebase|kubectl|\bhelm\b|terraform apply|pulumi up|docker push|build-push-action|goreleaser"
    r"|twine upload|cargo publish|\"environment\"", re.I)

OTHER_CI = [".gitlab-ci.yml", ".circleci/config.yml", "Jenkinsfile", ".buildkite/**", "bitbucket-pipelines.yml",
            ".drone.yml", "azure-pipelines.yml", ".woodpecker.yml", ".woodpecker/**"]
PLATFORMS = ["**/netlify.toml", "**/vercel.json", "**/render.yaml", "**/wrangler.toml", "**/wrangler.json",
             "**/wrangler.jsonc", "**/.platform.app.yaml", "app.json", "**/railway.json", "**/railway.toml"]
DOCS = ["CLAUDE.md", "AGENTS.md", "README.md", "CONTRIBUTING.md", "docs/deploy.md", "docs/deployment.md"]


REVIEW_LINES = 300       # changed lines past which a stack gets a review before it lands
BUG_HUNT_LINES = 2000    # changed lines past which the review is review's bug hunt
LOCKFILES = ["**/*.lock", "**/package-lock.json", "**/pnpm-lock.yaml", "**/bun.lockb", "**/go.sum", "**/flake.lock",
             "**/npm-shrinkwrap.json"]
GENERATED = ["**/dist/**", "**/build/**", "**/generated/**", "**/__generated__/**", "**/*.generated.*", "**/*.min.js",
             "**/*.min.css", "**/*.map", "**/*.pb.go", "**/*_pb2.py", "**/__snapshots__/**", "**/*.snap"]
SENSITIVE = [
    ("a schema or a migration", re.compile(r"(^|/)(migrations?|migrate|schemas?)(/|\.|_|-|$)|\.sql$|(^|/)schema\.prisma$", re.I)),
    ("auth or permissions", re.compile(r"(^|/|_|-)(auth|oauth|login|permissions?|acl|rbac|grants?|polic(y|ies)|credentials?)(/|\.|_|-|$)", re.I)),
    ("billing", re.compile(r"(^|/|_|-)(billing|payments?|invoices?|stripe|subscriptions?|pricing)(/|\.|_|-|$)", re.I)),
]
DELETION = re.compile(r"\b(drop\s+(table|database|schema|column)|delete\s+from|truncate\s+table)\b", re.I)


class CheckError(Exception):
    pass


# --- GitHub's filter patterns and a YAML subset ------------------------------

def glob_re(pattern):
    """GitHub's filter pattern syntax: * no slash, ** anything, ? and + quantify
    the character before them, [..] a class."""
    out, i = [], 0
    while i < len(pattern):
        c = pattern[i]
        if pattern.startswith("**", i):
            out.append(".*")
            i += 2
            if i < len(pattern) and pattern[i] == "/":
                out[-1] = "(?:.*/)?"
                i += 1
            continue
        if c == "*":
            out.append("[^/]*")
        elif c in "?+":
            out.append(c)
        elif c == "[":
            end = pattern.find("]", i)
            if end == -1:
                out.append(re.escape(c))
            else:
                out.append(pattern[i:end + 1])
                i = end
        else:
            out.append(re.escape(c))
        i += 1
    return re.compile("".join(out) + r"\Z")


def matches(pattern, path):
    try:
        return bool(glob_re(pattern).match(path))
    except re.error:
        return False


def filtered(patterns, path):
    """GitHub's rule for a list with ! negations: the last pattern that matches decides."""
    hit = False
    for p in patterns:
        p = str(p)
        if p.startswith("!"):
            if matches(p[1:], path):
                hit = False
        elif matches(p, path):
            hit = True
    return hit


def strip_comment(line):
    quote = None
    for i, c in enumerate(line):
        if quote:
            if c == quote:
                quote = None
        elif c in "'\"":
            quote = c
        elif c == "#" and (i == 0 or line[i - 1] in " \t"):
            return line[:i].rstrip()
    return line.rstrip()


def scalar(text):
    text = text.strip()
    if not text:
        return None
    if text[0] == "[" and text.endswith("]"):
        return [scalar(x) for x in split_flow(text[1:-1])]
    if text[0] == "{" and text.endswith("}"):
        out = {}
        for item in split_flow(text[1:-1]):
            k, _, v = item.partition(":")
            out[str(scalar(k))] = scalar(v)
        return out
    if len(text) > 1 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1]
    return text


def split_flow(text):
    items, depth, quote, cur = [], 0, None, ""
    for c in text:
        if quote:
            quote = None if c == quote else quote
        elif c in "'\"":
            quote = c
        elif c in "[{":
            depth += 1
        elif c in "]}":
            depth -= 1
        elif c == "," and depth == 0:
            items.append(cur)
            cur = ""
            continue
        cur += c
    if cur.strip():
        items.append(cur)
    return [i for i in items if i.strip()]


KEY = re.compile(r"""^("[^"]*"|'[^']*'|[^\s'"\[{][^:]*?)\s*:(?:\s+(.*)|$)""")


def parse_yaml(text):
    """Block mappings and sequences, flow lists and maps, quoted scalars, block
    scalars: the part of YAML a workflow's `on:` and `jobs:` use."""
    lines = []
    raw = text.splitlines()
    i = 0
    while i < len(raw):
        line = strip_comment(raw[i].replace("\t", "  "))
        i += 1
        if not line.strip() or line.strip() in ("---", "..."):
            continue
        body = line.strip()
        while body.count("[") > body.count("]") and i < len(raw):
            body += " " + strip_comment(raw[i]).strip()
            i += 1
        lines.append([len(line) - len(line.lstrip()), body])
    value, end = node(lines, 0, lines[0][0] if lines else 0)
    if end != len(lines):
        raise ValueError(f"unparsed from line {end}: {lines[end][1]!r}")
    return value


def node(lines, i, indent):
    if i >= len(lines) or lines[i][0] < indent:
        return None, i
    indent = lines[i][0]
    if lines[i][1] == "-" or lines[i][1].startswith("- "):
        return sequence(lines, i, indent)
    return mapping(lines, i, indent)


def block_scalar(lines, i, indent):
    parts = []
    while i < len(lines) and lines[i][0] > indent:
        parts.append(lines[i][1])
        i += 1
    return "\n".join(parts), i


def mapping(lines, i, indent):
    out = {}
    while i < len(lines) and lines[i][0] == indent and not (lines[i][1] == "-" or lines[i][1].startswith("- ")):
        m = KEY.match(lines[i][1])
        if not m:
            raise ValueError(f"not a key: {lines[i][1]!r}")
        key, rest = str(scalar(m.group(1))), (m.group(2) or "").strip()
        i += 1
        if rest[:1] in ("|", ">"):
            out[key], i = block_scalar(lines, i, indent)
        elif rest:
            out[key] = scalar(rest)
        elif i < len(lines) and (lines[i][0] > indent or (lines[i][0] == indent and lines[i][1].startswith("-"))):
            out[key], i = node(lines, i, lines[i][0])
        else:
            out[key] = None
    return out, i


def sequence(lines, i, indent):
    out = []
    while i < len(lines) and lines[i][0] == indent and (lines[i][1] == "-" or lines[i][1].startswith("- ")):
        rest = lines[i][1][1:].strip()
        if not rest:
            value, i = node(lines, i + 1, indent + 1)
            out.append(value)
        elif KEY.match(rest) and not rest.startswith(("'", '"')):
            lines[i] = [indent + 2 + (len(lines[i][1][1:]) - len(lines[i][1][1:].lstrip()) - 1), rest]
            value, i = mapping(lines, i, lines[i][0])
            out.append(value)
        elif rest[:1] in ("|", ">"):
            value, i = block_scalar(lines, i + 1, indent)
            out.append(value)
        else:
            out.append(scalar(rest))
            i += 1
    return out, i


# --- the repo --------------------------------------------------------------

class Repo:
    def __init__(self, cwd):
        self.cwd = cwd

    def jj(self, *args, check=True):
        r = subprocess.run(["jj", "--no-pager", "--color=never", *args], cwd=self.cwd, capture_output=True,
                           text=True, env={**os.environ, "JJ_EDITOR": "true", "EDITOR": "true"})
        if check and r.returncode != 0:
            raise CheckError(f"`jj {' '.join(args)}` failed: {r.stderr.strip()}")
        return r

    def revs(self, revset):
        template = ('json(change_id.short(12)) ++ "\\t" ++ json(commit_id) ++ "\\t" ++ json(empty) ++ "\\t" ++ '
                    'json(conflict) ++ "\\t" ++ json(parents.len()) ++ "\\t" ++ json(description) ++ "\\n"')
        out = self.jj("log", "--no-graph", "--reversed", "-r", revset, "-T", template).stdout
        revs = []
        for line in out.splitlines():
            change, commit, empty, conflict, parents, description = map(json.loads, line.split("\t"))
            revs.append({"change": change, "commit": commit, "subject": description.split("\n", 1)[0].strip(),
                         "description": description, "empty": empty, "conflict": conflict, "merge": parents > 1})
        return revs

    def exists(self, revset):
        return self.jj("log", "--no-graph", "-r", f"present({revset})", "-T", '"x"').stdout != ""

    def files(self, rev):
        return [f for f in self.jj("file", "list", "-r", rev).stdout.splitlines() if f]

    def show(self, rev, path):
        r = self.jj("file", "show", "-r", rev, "root:" + json.dumps(path), check=False)
        return r.stdout if r.returncode == 0 else None


def repo_at(path):
    """The repo holding path, run from its workspace root: jj prints paths relative to its working directory, and
    land-check compares them with root-relative patterns."""
    here = str(Path(path).resolve())
    r = Repo(here).jj("workspace", "root", check=False)
    return Repo(r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else here)


def rev_json(rev, commit=False):
    out = {"change": rev["change"], "subject": rev["subject"]}
    if commit:
        out["commit"] = rev["commit"]
    out.update({k: True for k in ("merge", "empty", "conflict") if rev[k]})
    return out


# --- deploy detection ------------------------------------------------------

def triggers(on):
    """{event: config or None} from a workflow's `on:`."""
    if isinstance(on, str):
        return {on: None}
    if isinstance(on, list):
        return {str(e): None for e in on}
    if isinstance(on, dict):
        return {str(k): v for k, v in on.items()}
    return {}


def push_fires(cfg, bookmark, files):
    """Does a push of files to bookmark fire this push trigger? (fires, why)"""
    if cfg is None:
        return True, "on every push"
    if not isinstance(cfg, dict):
        return True, "on push"
    listify = lambda v: v if isinstance(v, list) else [v] if v is not None else []
    branches, ignore = listify(cfg.get("branches")), listify(cfg.get("branches-ignore"))
    if branches and not filtered(branches, bookmark):
        return False, f"its push branches {branches} leave out {bookmark}"
    if ignore and filtered(ignore, bookmark):
        return False, f"its branches-ignore {ignore} names {bookmark}"
    if not branches and not ignore and (cfg.get("tags") or cfg.get("tags-ignore")):
        return False, "it fires on tag pushes only"
    paths, paths_ignore = listify(cfg.get("paths")), listify(cfg.get("paths-ignore"))
    if paths and files and not any(filtered(paths, f) for f in files):
        return False, f"no changed file matches its paths {paths}"
    if paths_ignore and files and all(filtered(paths_ignore, f) for f in files):
        return False, f"every changed file matches its paths-ignore {paths_ignore}"
    return True, f"on push to {bookmark}"


def deploy_jobs(workflow, bookmark):
    """Names of jobs that look like deploys and are not limited to another branch."""
    jobs = workflow.get("jobs") if isinstance(workflow.get("jobs"), dict) else {}
    marked = {j for j, job in jobs.items() if DEPLOY_WORDS.search(j + " " + json.dumps(job))}
    if not marked and DEPLOY_WORDS.search(str(workflow.get("name") or "")):
        marked = set(jobs)  # a workflow named for deploying, with no job that says how
    found = []
    for job_id, job in jobs.items():
        if job_id not in marked:
            continue
        cond = str(job.get("if") or "") if isinstance(job, dict) else ""
        refs = re.findall(r"refs/heads/([\w./-]+)", cond)
        if refs and bookmark not in refs:
            continue
        found.append(job_id)
    return found


def read_workflows(repo, head, tracked):
    workflows, reasons = {}, []
    for path in tracked:
        if re.match(r"^\.github/workflows/[^/]+\.ya?ml$", path):
            text = repo.show(head, path) or ""
            try:
                data = parse_yaml(text)
                if not isinstance(data, dict):
                    raise ValueError("not a mapping")
                workflows[path] = (data, text)
            except (ValueError, IndexError) as e:
                workflows[path] = (None, text)
                reasons.append(f"could not read {path} ({e})")
    return workflows, reasons


def deploy_status(repo, head, bookmark, files, tracked):
    """(true | false | "unknown", reasons, only_actions, paths lists of firing deploy workflows)."""
    workflows, reasons = read_workflows(repo, head, tracked)
    deploying, unknown, deploy_paths = [], [], []
    push_named = {}
    for path, (data, _) in workflows.items():
        if data is None:
            unknown.append(path)
            continue
        push_named[str(data.get("name") or Path(path).stem)] = (path, data)
    for path, (data, _) in workflows.items():
        if data is None:
            continue
        on = triggers(data.get("on", data.get(True)))
        jobs = deploy_jobs(data, bookmark)
        fired = []
        if "push" in on:
            ok, why = push_fires(on["push"], bookmark, files)
            if ok:
                fired.append(why)
            elif jobs:
                reasons.append(f"{path} deploys ({', '.join(jobs)}) but not for this push: {why}")
        if "workflow_run" in on and isinstance(on["workflow_run"], dict):
            cfg = on["workflow_run"]
            branches = cfg.get("branches")
            for name in (cfg.get("workflows") or []):
                upstream = push_named.get(str(name))
                if not upstream:
                    continue
                up_on = triggers(upstream[1].get("on"))
                if "push" in up_on and push_fires(up_on["push"], bookmark, files)[0] and (
                        not branches or filtered(branches if isinstance(branches, list) else [branches], bookmark)):
                    fired.append(f"after {name}, which runs on push to {bookmark}")
        if fired and jobs:
            deploying.append(f"{path} deploys ({', '.join(jobs)}) {fired[0]}")
            push_cfg = on.get("push") if isinstance(on.get("push"), dict) else {}
            deploy_paths.append(push_cfg.get("paths") or [])
    others = [p for p in tracked if any(matches(g, p) for g in OTHER_CI)]
    platforms = [p for p in tracked if any(matches(g, p) for g in PLATFORMS)]
    doc_lines = []
    for doc in DOCS:
        if doc in tracked:
            for line in (repo.show(head, doc) or "").splitlines():
                low = line.lower()
                if "deploy" in low and re.search(r"\b(push|pushed|pushes|merge|merged|land|lands)\b", low):
                    doc_lines.append(f"{doc}: {line.strip()[:120]}")
    if deploying:
        reasons += deploying
        if others:
            reasons.append("CI outside GitHub Actions too, not read: " + ", ".join(others))
        return True, reasons, not others, deploy_paths
    if unknown or others or platforms or doc_lines:
        if others:
            reasons.append("CI outside GitHub Actions, not read: " + ", ".join(others))
        if platforms:
            reasons.append("a platform config that may deploy on push through its git integration: "
                           + ", ".join(platforms))
        reasons += [f"the docs mention deploying on push: {d}" for d in doc_lines]
        return "unknown", reasons, False, deploy_paths
    reasons.append(f"no workflow deploys on a push to {bookmark}" if workflows
                   else "no CI config and no deploy config in the repo")
    return False, reasons, True, deploy_paths


def kind(path):
    for name, patterns in NON_DEPLOYING.items():
        if any(matches(p, path) for p in patterns):
            return name
    return None


GATE_FREE = re.compile(
    r"[^/]+\.md|LICENSE(\.(md|txt))?|CODEOWNERS"  # the root's docs
    r"|(docs?|adrs?)/(.+/)?[^/]+\.(md|txt)"  # the top-level docs and ADR folders
    r"|\.tstack/memo/.+|\.tstack/reviews/[^/]+\.tsv")  # memo notes and review records
GATED_TEXT = re.compile(r"(^|/)((requirements|constraints)[^/]*\.txt|CMakeLists\.txt)$")  # build inputs


def gate_free(path):
    """Whether no gate run reads path: a Markdown file, LICENSE or CODEOWNERS at the root, a .md or .txt file in the
    top-level docs/, doc/, adr/ or adrs/ folder, a memo note, or a review record. A README or docs folder among code
    may be what a gate validates or compiles (a skill's README, a crate's through include_str!), .mdx and .rst
    compile, and a requirements.txt or CMakeLists.txt is a build's input."""
    return bool(GATE_FREE.fullmatch(path)) and not GATED_TEXT.search(path)


def has_marker(text):
    low = text.lower()
    return any(m in low for m in SKIP_MARKERS)


def skip_ci_habit(repo, base, head, tracked, workflows_text):
    sample = repo.revs(f"latest(::{base} ~ root(), {HABIT_SAMPLE})")
    marked = [r for r in sample if has_marker(r["description"])]
    reasons = []
    if marked:
        reasons.append(f"{len(marked)} of the last {len(sample)} trunk commits carry [skip ci]")
    if any(has_marker(t) for t in workflows_text):
        reasons.append("a workflow tests for [skip ci]")
    for doc in DOCS:
        if doc in tracked and has_marker(repo.show(head, doc) or ""):
            reasons.append(f"{doc} mentions [skip ci]")
    return bool(reasons), reasons


# --- the check -------------------------------------------------------------

def land_check(repo, bookmark, head_rev=None, remote=LANDING_REMOTE, apply_skip_ci=False, ledger_dir=None,
               push_token=None, require_reviews=False):
    reasons = []
    remote_ref = f"{bookmark}@{remote}"
    if repo.exists(remote_ref):
        base = remote_ref
    elif repo.exists(bookmark):
        base = bookmark
        reasons.append(f"{remote_ref} does not exist: the push creates it")
    else:
        raise CheckError(f"neither {bookmark} nor {remote_ref} exists")

    if head_rev:
        heads = repo.revs(head_rev)
    else:
        work = f"(roots({base}..@)::) ~ (empty() & description(exact:\"\") & ~merges())"
        heads = repo.revs(f"heads({work})")
    result = {"bookmark": bookmark, "remote": remote, "head": None, "ff": False, "stack": [], "files": [],
              "deploys_on_push": "unknown", "skip_ci_habit": False, "skip_ci_marked": False,
              "suggest_skip_ci": False, "gate_needed": True, "verdict": "stop", "reasons": reasons}
    if not heads:
        reasons.append(f"nothing to push: no described work between {base} and @")
        return result
    if len(heads) > 1:
        result["heads"] = [rev_json(h) for h in heads]
        reasons.append(f"the work has {len(heads)} heads ({', '.join(h['change'] for h in heads)}): "
                       "name the one to land, or join them with a merge (`jj new A B -m ...`)")
        return result
    head = heads[0]

    stack = repo.revs(f"{base}..{head['commit']}")
    ff = repo.exists(f"{base} & ::{head['commit']}")
    if repo.exists(bookmark) and not repo.exists(f"{bookmark} & ::{head['commit']}"):
        ff = False
        reasons.append(f"the local {bookmark} has commits the head does not: moving it would drop them")
    if not ff and base == remote_ref:
        reasons.append(f"{remote_ref} is not an ancestor of {head['change']}: the push would rewrite remote history")
    if not stack:
        reasons.append(f"nothing to push: {head['change']} is already in {base}")
    for rev in stack:
        if not rev["subject"]:
            reasons.append(f"{rev['change']} has no description: jj will not push it")
        if rev["conflict"]:
            reasons.append(f"{rev['change']} has conflicts: jj will not push it")
        if rev["empty"] and not rev["merge"] and rev["subject"]:
            reasons.append(f"note: {rev['change']} ({rev['subject']}) is empty")

    files = [f for f in repo.jj("diff", "--name-only", "--from", base, "--to", head["commit"]).stdout.splitlines()
             if f]
    tracked = set(repo.files(head["commit"]))
    deploys, deploy_reasons, only_actions, deploy_paths = deploy_status(repo, head["commit"], bookmark, files,
                                                                        tracked)
    reasons += deploy_reasons
    workflow_texts = [repo.show(head["commit"], p) or "" for p in tracked if p.startswith(".github/workflows/")]
    habit, habit_reasons = skip_ci_habit(repo, base, head["commit"], tracked, workflow_texts)
    reasons += habit_reasons
    marked = has_marker(head["subject"])

    quiet = {}
    for f in files:
        k = kind(f)
        if k and any(filtered(paths, f) for paths in deploy_paths if paths):
            k = None  # a deploy workflow names this path: it is what gets deployed
        quiet[f] = k
    loud = [f for f, k in quiet.items() if not k]
    suggest = habit and not marked and bool(files) and not loud
    if habit and not marked and loud:
        reasons.append("no [skip ci]: these files may need CI or a deploy: " + ", ".join(loud[:8]))
    elif suggest:
        reasons.append("every file is " + "/".join(sorted({k for k in quiet.values()})) + ": [skip ci] fits")

    if apply_skip_ci and suggest:
        first, _, rest = head["description"].partition("\n")
        repo.jj("describe", "-r", head["commit"], "-m", f"{first.rstrip()} [skip ci]\n{rest}".rstrip("\n") + "\n")
        result = land_check(repo, bookmark, head["change"], remote, ledger_dir=ledger_dir, push_token=push_token,
                            require_reviews=require_reviews)
        result["skip_ci_applied"] = True
        return result

    result.update({
        "head": rev_json(head, commit=True), "ff": ff, "stack": [rev_json(r) for r in stack], "files": files,
        "deploys_on_push": deploys, "skip_ci_habit": habit, "skip_ci_marked": marked, "suggest_skip_ci": suggest,
        "gate_needed": not files or not all(gate_free(f) for f in files),
    })
    unreviewed = False
    if stack:
        try:
            result["review"] = review_status(repo, base, head["commit"], stack, ledger_dir,
                                             review_records(repo, head["commit"], tracked, stack))
            result["reviews"] = result["review"].pop("per_change")
            reasons += review_reasons(result["review"])
            if require_reviews:
                required = required_reasons(result["reviews"])
                reasons += required
                unreviewed = bool(required)
        except (CheckError, OSError) as e:
            reasons.append(f"note: the review check did not run: {e}")
    holds = others_landings(repo.cwd, push_token)
    if holds:
        result["freeze"] = [{"fleet": h.get("fleet"), "what": h.get("what"), "pushing": h.get("pushing") is True,
                             "until": h.get("until"), "ends": h.get("ends")} for h in holds]
        reasons += [freeze_reason(h) for h in holds]
    blocked = (not ff or not stack or any(not r["subject"] or r["conflict"] for r in stack) or bool(holds)
               or unreviewed)
    if blocked:
        result["verdict"] = "stop"
    elif deploys is False:
        result["verdict"] = "push"
    elif deploys is True and only_actions and marked:
        result["verdict"] = "push"
        reasons.append("[skip ci] on the head stops the GitHub Actions deploys")
    else:
        result["verdict"] = "ask"
        if deploys is True and only_actions and suggest:
            reasons.append("--apply-skip-ci would mark the head and make this a push")
        if deploys is True and not only_actions and (marked or suggest):
            reasons.append("[skip ci] may not stop every deploy source")
    return result


# --- review before landing ---------------------------------------------------

def generated_patterns(repo, head):
    """The .gitattributes patterns at head marked linguist-generated, -diff or binary, as filter patterns."""
    text = repo.show(head, ".gitattributes") or ""
    out = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 2 or parts[0].startswith("#"):
            continue
        attrs = parts[1:]
        if any(a in ("linguist-generated", "linguist-generated=true", "-diff", "binary") for a in attrs):
            pattern = parts[0].lstrip("/")
            out.append(pattern if "/" in parts[0].rstrip("/") else "**/" + pattern)
    return out


def diff_counts(text):
    """{path: (changed lines, added lines)} from a git-format diff."""
    files, path = {}, None
    for line in text.splitlines():
        if line.startswith("diff --git "):
            path = line.split(" b/", 1)[1] if " b/" in line else None
            if path is not None:
                files[path] = [0, []]
        elif path is None or line.startswith(("+++ ", "--- ")):
            continue
        elif line.startswith("+"):
            files[path][0] += 1
            files[path][1].append(line[1:])
        elif line.startswith("-"):
            files[path][0] += 1
    return {p: (n, added) for p, (n, added) in files.items()}


def ancestors():
    """This process and its parents, by pid."""
    pids, pid = [], os.getpid()
    while pid > 1 and pid not in pids:
        pids.append(pid)
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
            pid = int(stat.rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True)
            try:
                pid = int(r.stdout.strip())
            except ValueError:
                break
    return pids


def registry_home():
    if os.environ.get("FLEET_HOME"):
        return Path(os.environ["FLEET_HOME"])
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(base) / "fleet-board"


def find_ledger(explicit=None):
    """The fleet ledger to read: --ledger, $FLEET_DIR, else the served fleet (not the manager) whose
    registry entry's pid is among this process's parents. None when there is none."""
    for d in (explicit, os.environ.get("FLEET_DIR")):
        if d and (Path(d) / "state.json").is_file():
            return Path(d) / "state.json"
    mine = set(ancestors())
    try:
        entries = sorted(p for p in registry_home().glob("*.json") if p.is_file())
    except OSError:
        return None
    for p in entries:
        try:
            entry = json.loads(p.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(entry, dict) and entry.get("pid") in mine and entry.get("role") != "manager" \
                and isinstance(entry.get("dir"), str) and (Path(entry["dir"]) / "state.json").is_file():
            return Path(entry["dir"]) / "state.json"
    return None


def reviewed_changes(ledger):
    """The reviews the ledger's `reviewed` events record, oldest first: {change, commit, at} each, the commit the
    reviewer read from a `change@commit` entry, None from a bare change id (an event from before commits were
    recorded). A change id shorter than four characters could be anything, and is left out."""
    try:
        state = json.loads(ledger.read_text())
    except (OSError, ValueError):
        return []
    out = []
    for e in state.get("events", []) if isinstance(state, dict) else []:
        if isinstance(e, dict) and e.get("kind") == "reviewed" and isinstance(e.get("changes"), list):
            for c in e["changes"]:
                if not isinstance(c, str):
                    continue
                change, _, commit = c.partition("@")
                if len(change) >= 4:
                    out.append({"change": change, "commit": commit or None, "at": str(e.get("at") or "")})
    return out


def clock(at):
    """HH:MM of a ledger time, as the reasons name it."""
    return at[11:16] if len(at) >= 16 else at or "an unknown time"


def utc_seconds(at):
    """A ledger time (RFC 3339) as UTC, to the second, comparable as text with jj's; None when it does not parse."""
    try:
        when = datetime.fromisoformat(at.replace("Z", "+00:00"))
    except ValueError:
        return None
    if when.tzinfo is None:
        return None
    return when.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")


COMMIT = re.compile(r"[0-9a-f]{8,}")  # what a review names after the `@`: a commit id's hex, never a revset


def evolog(repo, change):
    """The commits change has been, newest first: (commit id, committer time in UTC to the second) each, its own
    entries only (a squash's sources are left out). None when jj cannot read it (a divergent change)."""
    template = ('commit.change_id() ++ " " ++ commit.commit_id() ++ " " ++ '
                'commit.committer().timestamp().utc().format("%Y-%m-%dT%H:%M:%S") ++ "\\n"')
    r = repo.jj("evolog", "--no-graph", "-r", change, "-T", template, check=False)
    if r.returncode != 0:
        return None
    return [(parts[1], parts[2]) for parts in (line.split() for line in r.stdout.splitlines())
            if len(parts) == 3 and parts[0].startswith(change)]


def commit_then(repo, change, at):
    """The commit change was at when a review recorded at `at` read it: the latest entry of `jj evolog` for that
    change written before then, to the second (one in the same second counts as after the review). None when it
    has none."""
    when = utc_seconds(at)
    entries = evolog(repo, change) if when is not None else None
    return next((commit for commit, written in entries or [] if written < when), None)


def not_its_commit(repo, change, commit):
    """Why `commit` cannot be taken as one change has been: not a commit id, or one jj evolog does not show for that
    change. None when it is one of the change's. A change jj cannot read the evolog of (abandoned by a reshape, or
    divergent) owns the commit when the commit's own change id is its."""
    if not COMMIT.fullmatch(commit):
        return f"names `{commit}`, not a commit id (8 or more hex digits)"
    entries = evolog(repo, change)
    if entries is None:
        r = repo.jj("log", "--no-graph", "-r", commit, "-T", "change_id", check=False)
        mine = r.returncode == 0 and r.stdout.strip().startswith(change)
    else:
        mine = any(c.startswith(commit) for c, _ in entries)
    return None if mine else f"names commit {commit}, which jj evolog does not show for this change"


PATCH_LINES = re.compile(r"diff --git |(new|deleted) file mode |old mode |new mode |rename (from|to) |[-+\\]")


def patch_fingerprint(repo, rev):
    """The hash of what rev changes, the same on any clone and across a rebase that leaves its patch alone: sha256 of
    its `jj diff --git` (review records left out) cut to the file headers, mode and rename lines, and the added and
    removed lines; the index lines (blob ids) and the hunk headers and context lines (which move with a rebase)
    are dropped, but a binary file keeps its after-blob id. Lines moved within a file read as the same patch. Its
    first 16 hex digits; None when jj cannot read rev."""
    r = repo.jj("diff", "--git", "-r", rev, NOT_RECORDS, check=False)
    if r.returncode != 0:
        return None
    kept = []
    for part in re.split(r"(?m)^(?=diff --git )", r.stdout):
        lines = part.splitlines()
        kept += [line for line in lines if PATCH_LINES.match(line)]
        if any(line.startswith(("Binary files ", "GIT binary patch")) for line in lines):
            # A binary diff has no +/- lines; its after-blob is the content, and it does not move with a rebase.
            kept += [line.split("..")[1].split()[0] for line in lines if line.startswith("index ") and ".." in line]
    return hashlib.sha256("\n".join(kept).encode()).hexdigest()[:16]


def interdiff(repo, frm, to):
    """What changed between two commits of one change, as their patches: (files, added, removed). None when jj
    cannot compare them (a commit this repo does not have)."""
    r = repo.jj("interdiff", "--git", "--from", frm, "--to", to, NOT_RECORDS, check=False)
    return diff_summary(r.stdout) if r.returncode == 0 else None


def diff_summary(text):
    """A git-format diff as (files, added, removed)."""
    counts = diff_counts(text)
    added = sum(len(a) for _, a in counts.values())
    return len(counts), added, sum(n for n, _ in counts.values()) - added


def files_and_lines(files, added, removed):
    return f"{files} file{'' if files == 1 else 's'}, +{added}/-{removed}"


def show_interdiff(repo, reviewed, to=None):
    """--interdiff: print `jj interdiff` from the commit a review read to the change now (or to `to`, the change a
    reshape made of it), and say on stderr whether it is empty. 0 when it is, 1 when not, 2 when `reviewed` is not
    a change@commit of that change, or jj cannot compare them."""
    change, _, commit = reviewed.partition("@")
    why = (f"names `{reviewed}`, not change@commit" if len(change) < 4 or not commit
           else not_its_commit(repo, change, commit))
    if why is not None:
        print(f"land-check: --interdiff: {change} {why}", file=sys.stderr)
        return 2
    to = to or change
    r = repo.jj("interdiff", "--git", "--from", commit, "--to", to, NOT_RECORDS, check=False)
    if r.returncode != 0:
        print(f"land-check: --interdiff: jj cannot compare {reviewed} with {to}: {r.stderr.strip()}", file=sys.stderr)
        return 2
    sys.stdout.write(r.stdout)
    files, added, removed = diff_summary(r.stdout)
    if files == 0:
        print(f"land-check: --interdiff: {to} has not changed since {reviewed}", file=sys.stderr)
        return 0
    print(f"land-check: --interdiff: {to} changed since {reviewed} ({files_and_lines(files, added, removed)}): "
          "review it again", file=sys.stderr)
    return 1


def review_of(repo, rev, reviews):
    """How the recorded reviews of one change in the stack stand against its current commit: (state, detail).
    State "none": no review names the change; "reviewed": some review read the change's current content (its
    commit, or one whose interdiff to it is empty: a pure rebase); "changed": the latest review read other
    content, detail {at, commit, files, added, removed, inferred}; "unknown": the latest review names no commit
    and jj evolog has none from before it, names something other than one of the change's commits (`why`), or
    one this repo cannot compare. A review with no commit is taken at the commit the change was at then
    (inferred)."""
    mine = [r for r in reviews if rev["change"].startswith(r["change"]) or r["change"].startswith(rev["change"])]
    if not mine:
        return "none", None
    last = None
    patch = patch_fingerprint(repo, rev["commit"]) if any(r.get("patch") for r in mine) else None
    for r in reversed(mine):
        inferred = r["commit"] is None
        if patch is not None and r.get("patch") == patch:
            return "reviewed", {"inferred": False, "commit": r["commit"], "at": r["at"], "reviewer": r.get("reviewer")}
        why = None if inferred else not_its_commit(repo, rev["change"], r["commit"])
        if why and r.get("patch"):
            why += ", and its patch fingerprint is not the change's now"
        commit = commit_then(repo, rev["change"], r["at"]) if inferred else None if why else r["commit"]
        diff = None
        if commit is not None and not rev["commit"].startswith(commit):
            diff = interdiff(repo, commit, rev["commit"])
        if commit is not None and (diff is None and rev["commit"].startswith(commit) or diff and diff[0] == 0):
            return "reviewed", {"inferred": inferred, "commit": commit, "at": r["at"], "reviewer": r.get("reviewer")}
        if last is None:
            last = {"at": r["at"], "commit": commit or r["commit"], "inferred": inferred, "diff": diff, "why": why,
                    "reviewer": r.get("reviewer")}
    if last["diff"] is None:
        unknown = {"at": last["at"], "commit": last["commit"], "inferred": last["inferred"]}
        return "unknown", {**unknown, "why": last["why"]} if last["why"] else unknown
    files, added, removed = last["diff"]
    return "changed", {"at": last["at"], "commit": last["commit"], "inferred": last["inferred"],
                       "files": files, "added": added, "removed": removed, "reviewer": last["reviewer"]}


def review_status(repo, base, head, stack, ledger_dir=None, records=()):
    """Whether the stack needs a review before it lands, and whether the fleet's ledger or the repo's review records
    record one; with, under `per_change`, how each change's recorded reviews stand (review_state)."""
    counts = diff_counts(repo.jj("diff", "--git", "--from", base, "--to", head).stdout)
    skip = LOCKFILES + GENERATED + generated_patterns(repo, head)
    counted = {p: v for p, v in counts.items() if not any(matches(g, p) for g in skip)}
    lines = sum(n for n, _ in counted.values())
    sensitive = []
    for p, (_, added) in counted.items():
        for label, pattern in SENSITIVE:
            if pattern.search(p):
                sensitive.append(f"{label}: {p}")
        if any(DELETION.search(a) for a in added):
            sensitive.append(f"a deletion of data: {p}")
    needed = lines > REVIEW_LINES or bool(sensitive)
    ledger = find_ledger(ledger_dir)
    reviews = sorted([*(reviewed_changes(ledger) if ledger else []), *records],
                     key=lambda r: utc_seconds(r["at"]) or r["at"])
    done, unreviewed, changed, inferred, per_change = [], [], [], [], []
    memo_only = memo_only_changes(repo, stack)
    for rev in (r for r in stack if not r["empty"] and r["change"] not in memo_only):
        state, detail = review_of(repo, rev, reviews)
        per_change.append(review_state(rev["change"], state, detail))
        if state == "none":
            unreviewed.append(rev["change"])
            continue
        if detail["inferred"]:
            inferred.append(rev["change"])
        if state == "reviewed":
            done.append(rev["change"])
        else:
            changed.append({"change": rev["change"], **detail})
    return {"lines": lines, "threshold": REVIEW_LINES, "sensitive": sensitive[:12], "needed": needed,
            "bug_hunt": lines > BUG_HUNT_LINES, "ledger": str(ledger) if ledger else None, "records": len(records),
            "per_change": per_change, "reviewed": done, "unreviewed": unreviewed, "changed_after_review": changed, "inferred": inferred}


REVIEWS_DIR = ".tstack/reviews/"  # the repo's review records: <change>.tsv, committed in the change it records
NOT_RECORDS = '~root:".tstack/reviews"'  # what an interdiff compares: a record is not reviewed content


def review_records(repo, head, tracked, stack):
    """The reviews the records at head of the stack's changes name, as reviewed_changes gives the ledger's: {change,
    commit, at, reviewer, verdict, patch} each. A row is `change@commit<TAB>at<TAB>reviewer<TAB>verdict<TAB>note
    [<TAB>patch]`, one per fresh review of the change's full diff or of its interdiff, `patch` its patch_fingerprint
    then (rows from before it have none); the header row and a row with no commit are skipped. A record of a change
    already landed is never read: it names no change of the stack."""
    def ours(path):
        name = path[len(REVIEWS_DIR):].removesuffix(".tsv")
        return len(name) >= 4 and "/" not in name and any(r["change"].startswith(name) or name.startswith(r["change"])
                                                           for r in stack)
    out = []
    for path in sorted(p for p in tracked if p.startswith(REVIEWS_DIR) and p.endswith(".tsv") and ours(p)):
        for line in (repo.show(head, path) or "").splitlines():
            cols = [c.strip() for c in line.split("\t")] + [""] * 5
            change, _, commit = cols[0].partition("@")
            if len(change) >= 4 and commit and cols[0] != "change@commit":
                out.append({"change": change, "commit": commit, "at": cols[1], "reviewer": cols[2] or None,
                            "verdict": cols[3] or None, "patch": cols[5] or None})
    return out


def memo_only_changes(repo, stack):
    """The changes of the stack that touch only .tstack/ (memo notes, review records): nothing in them to review."""
    template = 'change_id.short(12) ++ "\\t" ++ self.diff().files().map(|f| f.path().display()).join("\\t") ++ "\\n"'
    r = repo.jj("log", "--no-graph", "-r", " | ".join(r["commit"] for r in stack), "-T", template, check=False)
    out = set()
    for line in r.stdout.splitlines() if r.returncode == 0 else []:
        change, *files = line.split("\t")
        if files and files != [""] and all(f.startswith(".tstack/") for f in files):
            out.add(change)
    return out


def review_state(change, state, detail):
    """One change's entry in `reviews`: "current" (a review read its content: its commit, or one the interdiff to
    which is empty), "interdiff" (a review read an older commit: only the interdiff since needs reading), "missing"
    (no review, or none this repo can tie to the change's commits: its full diff needs reading)."""
    if state == "reviewed":
        return {"change": change, "state": "current", "since": detail["commit"], "at": detail["at"],
                "reviewer": detail["reviewer"]}
    if state == "changed":
        return {"change": change, "state": "interdiff", "since": detail["commit"], "at": detail["at"],
                "reviewer": detail["reviewer"],
                "interdiff": files_and_lines(detail["files"], detail["added"], detail["removed"])}
    entry = {"change": change, "state": "missing"}
    if state == "unknown":
        entry["why"] = detail.get("why") or f"its review names commit {detail['commit']}, which this repo cannot compare"
    return entry


def required_reasons(reviews):
    """--require-reviews: a warning per change whose content no review read."""
    out = []
    for r in reviews:
        if r["state"] == "missing":
            why = f" ({r['why']})" if "why" in r else ""
            out.append(f"warning: {r['change']}: no review records it{why}: review its full diff, then record it in "
                       f"{REVIEWS_DIR}{r['change']}.tsv")
        elif r["state"] == "interdiff":
            out.append(f"warning: {r['change']} changed since its review of {r['since']} ({r['interdiff']}): review "
                       f"only the interdiff (`land-check --interdiff {r['change']}@{r['since']}`), then record it at "
                       "the commit it read")
    return out


def changed_line(c):
    """Why one reviewed change needs its review again."""
    if "files" not in c:
        if "why" in c:
            return f"{c['change']}: its review at {clock(c['at'])} {c['why']}: review it again"
        if c["inferred"]:
            return (f"{c['change']}: its review at {clock(c['at'])} names no commit, and jj evolog has none from "
                    "before it: review it again, or record the commit it read")
        return (f"{c['change']}: its review at {clock(c['at'])} names commit {c['commit']}, which this repo cannot "
                "compare: review it again")
    files = files_and_lines(c["files"], c["added"], c["removed"])
    how = "; the reviewed commit inferred from jj evolog, as the event names none" if c["inferred"] else ""
    return f"{c['change']} changed after its review at {clock(c['at'])} ({files}{how}): review it again"


def review_reasons(review):
    """The reason lines a review status adds: a warning, a reminder, or what was reviewed."""
    if not review["needed"]:
        return []
    why = [f"{review['lines']} changed lines (over {review['threshold']})"] if review["lines"] > review["threshold"] else []
    why += review["sensitive"][:3]
    what = "; ".join(why)
    hunt = " (over 2,000 lines: review's bug hunt)" if review["bug_hunt"] else ""
    if review["ledger"] is None and not review["records"]:
        return [f"reminder: {what}: a stack like this gets tstack:review (Deep when contested){hunt} "
                "before it lands (coordinator SKILL.md, Integrate); no fleet ledger found to check"]
    record = ("`fleet state <dir> event --kind reviewed --findings N --proven P --changes \"<change>@<commit>,...\" "
              f"\"...\"` or a row in {REVIEWS_DIR}<change>.tsv")
    out = []
    if review["unreviewed"]:
        out.append(f"warning: {what}, and the ledger has no `reviewed` event for {', '.join(review['unreviewed'])}, "
                   f"nor does {REVIEWS_DIR}: "
                   f"run tstack:review (Deep when contested){hunt} before landing, then {record}")
    out += [f"warning: {changed_line(c)}, then {record} with the commit it read" for c in review["changed_after_review"]]
    if out:
        return out
    said = [f"reviewed: {what}; the ledger records a review of every change in the stack, at its current content"]
    if review["inferred"]:
        said.append(f"note: the reviews of {', '.join(review['inferred'])} name no commit: the commit each read is "
                    "inferred from jj evolog (the latest before the event's second)")
    return said


LANDING_DOCS = ["CLAUDE.md", "AGENTS.md", "README.md", "justfile", "Justfile", ".justfile"]
_NAME = r"([A-Za-z0-9_][\w./-]*)"
LANDING_SAID = [re.compile(r"jj git push\b[^\n`]*?(?:--bookmark[ =]|-b )" + _NAME),
                re.compile(r"jj bookmark (?:set|move) " + _NAME),
                re.compile(r"\bgit push \S+ \+?HEAD:refs/heads/" + _NAME),
                re.compile(r"landing bookmark[^\n`]{0,40}`" + _NAME + "`", re.I)]


def workspace_root(path):
    """The jj workspace or git checkout holding path, or None."""
    here = Path(path).resolve()
    for d in (here, *here.parents):
        if (d / ".jj").is_dir() or (d / ".git").exists():
            return d
    return None


def landing_bookmarks(path):
    """The bookmarks a push lands on in the repo holding path (the Land playbook's step 1): those its own docs
    push or name as the landing bookmark, and the one trunk() resolves to (origin's HEAD in a plain git
    checkout). main, master and trunk when neither says. Empty outside a repo."""
    root = workspace_root(path)
    if root is None:
        return set()
    names = set()
    for doc in LANDING_DOCS:
        try:
            text = (root / doc).read_text(errors="replace")
        except OSError:
            continue
        for pattern in LANDING_SAID:
            names.update(m.group(1) for m in pattern.finditer(text))
    trunk = None
    if (root / ".jj").is_dir():
        try:
            r = Repo(str(root)).jj("--ignore-working-copy", "log", "--no-graph", "-r", "trunk()", "-T",
                                   'remote_bookmarks.map(|b| b.name()).join(" ")', check=False)
            trunk = r.stdout.split() if r.returncode == 0 else None
        except OSError:
            trunk = None
    if not trunk:
        try:
            r = subprocess.run(["git", "-C", str(root), "symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD"],
                               capture_output=True, text=True, timeout=10)
            trunk = [r.stdout.strip().split("/", 1)[1]] if r.returncode == 0 and "/" in r.stdout else None
        except (OSError, subprocess.TimeoutExpired):
            trunk = None
    names.update(trunk or ([] if names else ["main", "master", "trunk"]))
    return names


REPO_FLEET = Path(__file__).resolve().parent.parent / "fleet" / "bin" / "fleet"


def fleet_cli(path=None, repo_cli=None):
    """The fleet CLI: bare `fleet` on PATH, else the launcher in this repo (until the fleet leaves it), else None."""
    found = shutil.which("fleet", path=path)
    if found:
        return Path(found)
    repo_cli = REPO_FLEET if repo_cli is None else Path(repo_cli)
    return repo_cli if repo_cli.exists() and shutil.which("bun") else None


def landing_turn(fleet=None, timeout=60, env=None, repo_cli=None):
    """`fleet turn` for the fleet this session serves: (exit code, what it said), or None when no fleet CLI
    can run. Exit 1 means a manager is present and the turn is another fleet's, or nobody's yet. env, when
    given, is the command's environment (the push gate names a moved fleet's folder in $FLEET_DIR)."""
    fleet = Path(fleet) if fleet else fleet_cli(repo_cli=repo_cli)
    if fleet is None or not fleet.exists():
        return None
    try:
        proc = subprocess.Popen([str(fleet), "turn"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                start_new_session=True, env=env)
    except OSError:
        return None
    def kill_group():
        # the whole group: the launcher and whatever it started
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass

    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        kill_group()
        proc.communicate()
        return None
    except BaseException:  # the hook's deadline: its own session would outlive the hook
        kill_group()
        raise
    return proc.returncode, (out if proc.returncode == 0 else err).strip()


def with_fleet(result, cli):
    """The JSON says which fleet CLI answered the turn: its path, or null when none was found (the turn and the
    ledger's reviewed events then went unchecked)."""
    result["fleet_cli"] = str(cli) if cli else None
    return result


def with_turn(result, turn):
    """The verdict once the landing turn is known: without it, a fleet under a manager stops."""
    if turn is None:
        return result
    code, said = turn
    if code == 1:
        result["verdict"] = "stop"
        result["turn"] = said.removeprefix("turn: ")
        result["reasons"].append(result["turn"])
    elif " holds the landing turn" in said:
        result["reasons"].append(said)
    return result


# --- another lane's landing ---------------------------------------------------

RUNS_TAIL = 256 * 1024  # bytes of the gate's run log read for a push hold's run: it passed within the last 2 minutes


def jj_store(root):
    """The jj store a workspace shares with its repository's others, as the gate names a landing's repository: its
    `.jj/repo` directory, or the one a later workspace's `.jj/repo` file names. None outside a jj workspace."""
    pointer = Path(root) / ".jj" / "repo"
    try:
        return os.path.realpath(pointer if pointer.is_dir() else pointer.parent / pointer.read_text().strip())
    except OSError:
        return None


def same_path(a, b):
    return isinstance(a, str) and isinstance(b, str) and os.path.realpath(a) == os.path.realpath(b)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        return True
    return True


def run_workspace(gate, token):
    """The workspace of the gate run that kept the push hold `token`, from the end of the gate's run log."""
    try:
        with open(gate / "runs.jsonl", "rb") as f:
            f.seek(max(0, f.seek(0, os.SEEK_END) - RUNS_TAIL))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            run = json.loads(line)
        except ValueError:
            continue
        if isinstance(run, dict) and run.get("push_token") == token:
            return run.get("workspace")
    return None


def others_landings(path, push_token=None):
    """The landings of the repository holding `path` that hold the machine's gate for another workspace: a landing
    gate running, or one that passed and keeps the landing turn for its push. A push now moves the tip that landing
    proved, and it gates again. Its own push is not one: the hold's workspace is this one, its token is
    `push_token`, or the run that kept it ran here; nor a gate run this process runs under. gate.json read only; a
    missing, unreadable or older file holds nothing."""
    root = workspace_root(path)
    store = jj_store(root) if root else None
    if store is None:
        return []
    gate = registry_home() / "gate"
    try:
        held = json.loads((gate / "gate.json").read_text())
    except (OSError, ValueError):
        return []
    holds = held.get("holds") if isinstance(held, dict) else None
    now = datetime.now(timezone.utc)
    mine = set(ancestors())
    out = []
    for h in holds if isinstance(holds, list) else []:
        if not isinstance(h, dict) or h.get("landing") is not True or not same_path(h.get("repo"), store):
            continue
        try:
            until = datetime.fromisoformat(str(h.get("until")).replace("Z", "+00:00"))
        except ValueError:
            continue
        if until.tzinfo is None or until <= now:
            continue
        pid = h.get("pid")
        if isinstance(pid, int) and (pid in mine or not alive(pid)):
            continue
        if same_path(h.get("workspace"), str(root)) or (push_token and h.get("token") == push_token):
            continue
        if h.get("pushing") is True and same_path(run_workspace(gate, h.get("token")), str(root)):
            continue
        out.append(h)
    return out


def freeze_reason(hold):
    who = hold.get("fleet") or "another lane"
    then = "fetch, rebase onto its push, and run land-check again"
    if hold.get("pushing") is True:
        return (f"{who}'s landing gate of this repository passed and holds the landing turn for its push until "
                f"{clock(str(hold.get('until')))}: a push now moves the tip it proved, and it gates again. Wait for "
                f"its push (`fleet fleets gate` shows the hold), then {then} (this lane's own landing: pass "
                "--push-token <the token its gate run printed>)")
    return (f"{who} is running a landing gate of this repository ({hold.get('what')}), expected to end by "
            f"{clock(str(hold.get('ends') or hold.get('until')))}: a push now moves the tip it is proving, and it "
            f"gates again. Wait until it has pushed or ended (`fleet fleets gate` shows the hold), then {then}")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="land-check", description=__doc__.split("\n\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=__doc__.split("\n\n", 1)[1])
    parser.add_argument("-R", "--repo", default=".")
    parser.add_argument("--bookmark", "-b")
    parser.add_argument("--head", help="the revision to land (default: the single head of the work under @)")
    parser.add_argument("--remote", default=LANDING_REMOTE)
    when = parser.add_mutually_exclusive_group()
    when.add_argument("--apply-skip-ci", action="store_true",
                      help="append [skip ci] to head's subject when suggest_skip_ci holds")
    when.add_argument("--pre-gate", action="store_true",
                      help="before the full gate: exit 1 when the stack needs a review the ledger does not record")
    when.add_argument("--interdiff", metavar="CHANGE@COMMIT",
                      help="print what changed in CHANGE since a review read COMMIT, and nothing else")
    when.add_argument("--fingerprint", metavar="CHANGE",
                      help="print CHANGE's patch fingerprint, the review record's patch column, and nothing else")
    parser.add_argument("--ledger", metavar="DIR", help="the fleet's dashboard directory, whose reviewed events are read")
    parser.add_argument("--to", metavar="CHANGE", help="with --interdiff: the change a reshape made of CHANGE")
    parser.add_argument("--require-reviews", action="store_true",
                        help="stop when a change's content has no review: its full diff, or its interdiff since one")
    parser.add_argument("--push-token", metavar="TOKEN",
                        help="the token this lane's passed landing gate printed: its own push hold freezes nothing")
    args = parser.parse_args(argv)
    if args.interdiff:
        return show_interdiff(repo_at(args.repo), args.interdiff, args.to)
    if args.fingerprint:
        patch = patch_fingerprint(repo_at(args.repo), args.fingerprint)
        if patch is None:
            print(f"land-check: --fingerprint: jj cannot read {args.fingerprint}", file=sys.stderr)
            return 2
        print(patch)
        return 0
    if args.to:
        parser.error("--to goes with --interdiff")
    if not args.bookmark:
        parser.error("the following arguments are required: --bookmark/-b")
    try:
        result = land_check(repo_at(args.repo), args.bookmark, args.head, args.remote,
                            args.apply_skip_ci, args.ledger, args.push_token, args.require_reviews)
    except CheckError as e:
        print(f"land-check: {e}", file=sys.stderr)
        return 2
    if not args.pre_gate:
        result = with_turn(result, landing_turn())
    result = with_fleet(result, fleet_cli())
    for reason in result["reasons"]:
        if reason.startswith(("warning: ", "reminder: ")):
            print(f"land-check: {reason}", file=sys.stderr)
    print(json.dumps(result, indent=2))
    if args.pre_gate:
        if not result["stack"]:
            for reason in result["reasons"]:
                if not reason.startswith(("warning: ", "reminder: ", "note: ")):
                    print(f"land-check: --pre-gate: {reason}", file=sys.stderr)
            return 1
        return 1 if any(r.startswith("warning: ") for r in result["reasons"]) else 0
    return 0 if result["verdict"] == "push" else 1


if __name__ == "__main__":
    sys.exit(main())
