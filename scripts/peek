#!/usr/bin/env python3
"""peek: show a file on this machine to Luiz on another device of the tailnet.

  peek <file>...   link each file and print its URL (hover it in Rex, press Cmd+Y)
  peek ls          the linked files and their URLs
  peek stop        stop the server and remove its tailnet route
  peek serve       run the server in the foreground (peek starts it on demand)
  peek refresh     replace a running server an older release left; start none

A release's peek replaces a server an older release started, on its first
`peek <file>` and at each session start (tstack's hook runs `peek refresh`), so
the server runs the newest installed code. Older means an older script mtime,
which is its install time; a server whose script has the same bytes, or a newer
mtime, stays. A dev copy run from a workspace has a fresh mtime and would keep
its server over the next release: run it with its own TSTACK_PEEK_PORT and
XDG_STATE_HOME.

Each file gets <state>/files/<id>/<name>, a symlink to its absolute path, where
<id> is a hash of that path: the same file keeps the same URL, and the link
shows its current content. The server answers only for those links, on
127.0.0.1, and `tailscale serve` publishes it to the tailnet, never to the
internet. Quick Look renders only HTML (and images) fetched from a URL; it
refuses a PDF or an Office file as "cannot be safely displayed" (tested from
Rex on macOS, 2026-11-16). So the server converts: Markdown to HTML through
pandoc, in its sandbox, so a page carries no local file the Markdown points to,
with each ```mermaid block drawn in the page by mermaid.js (Quick Look runs it),
and mmdr's SVG (mermaid-rs-renderer) shown until then and when mermaid.js fails;
documents (docx, doc, odt, rtf) and spreadsheets (xlsx, xls, ods) to HTML, with
images inlined, through headless LibreOffice on the serving machine. Without
LibreOffice a docx falls back to pandoc's HTML, and other files go out as they
are, typed from TYPES (Python's built-in table, all macOS has, lacks docx, xlsx
and pptx). Quick Look picks its renderer from the URL's extension, not the
Content-Type, so a converted file's URL ends in .html (report.docx.html). A
conversion is cached until the file changes.
"""

import fcntl
import hashlib
import html
import http.server
import json
import mimetypes
import os
import re
import shutil
import signal
import socket
import tempfile
import threading
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PORT = int(os.environ.get("TSTACK_PEEK_PORT", "8517"))
HEALTH = "/_peek"
VERSION = "/_peek/version"
SELF = Path(__file__).resolve()
BUILD = {"sha": hashlib.sha256(SELF.read_bytes()).hexdigest(), "mtime_ns": SELF.stat().st_mtime_ns}


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return Path(base) / "tstack" / "peek"


def files_dir():
    return state_dir() / "files"


def entry_id(path):
    return hashlib.sha256(str(path).encode()).hexdigest()[:10]


def link(path):
    source = Path(path).expanduser().resolve()
    if not source.is_file():
        raise SystemExit(f"peek: not a file: {path}")
    entry = files_dir() / entry_id(source)
    entry.mkdir(parents=True, exist_ok=True)
    target = entry / source.name
    if target.is_symlink() or target.exists():
        target.unlink()
    target.symlink_to(source)
    return f"{entry.name}/{urllib.parse.quote(source.name + view_suffix(source))}"


def view_suffix(source):
    """The extension a converted file adds to its URL: Quick Look picks its
    renderer from the URL's extension, not from the Content-Type."""
    suffix = source.suffix.lower()
    office = shutil.which("soffice") or shutil.which("libreoffice")
    if (suffix in DOCUMENTS or suffix in SHEETS) and office:
        return ".html"
    if suffix == ".docx" and shutil.which("pandoc"):
        return ".html"
    return ""


def resolve(url_path):
    parts = urllib.parse.unquote(url_path.split("?", 1)[0]).strip("/").split("/")
    if len(parts) != 2 or any(p in ("", ".", "..") for p in parts):
        return None
    name, view = parts[1], ""
    for extra in (".html",):
        if name.endswith(extra) and not (files_dir() / parts[0] / name).is_symlink():
            name, view = name[: -len(extra)], extra
    candidate = files_dir() / parts[0] / name
    if not candidate.is_symlink():
        return None
    source = candidate.resolve()
    return (source, view) if source.is_file() else None


MERMAID_BLOCK = re.compile(r"^```mermaid[ \t]*\n(.*?)^```[ \t]*$", re.MULTILINE | re.DOTALL)


def mermaid_svg(mmdr, diagram):
    try:
        run = subprocess.run([mmdr, "-e", "svg"], input=diagram.encode(), capture_output=True, timeout=30)
    except subprocess.TimeoutExpired:
        return None
    svg = run.stdout.decode(errors="replace")
    return svg if run.returncode == 0 and "<svg" in svg else None


MERMAID_JS = "https://cdn.jsdelivr.net/npm/mermaid@12.2.0/dist/mermaid.esm.min.mjs"
MERMAID_RUN = f"""<script type="module">
const blocks = [...document.querySelectorAll("pre.mermaid")];
if (blocks.length) {{
  try {{
    const mermaid = (await import("{MERMAID_JS}")).default;
    mermaid.initialize({{ startOnLoad: false }});
    blocks.forEach(b => b.hidden = false);
    await mermaid.run({{ nodes: blocks }});
    document.querySelectorAll(".mermaid-fallback").forEach(f => f.remove());
  }} catch (e) {{
    blocks.forEach(b => {{ if (b.nextElementSibling?.classList.contains("mermaid-fallback")) b.hidden = true; }});
  }}
}}
</script>
"""


def draw_mermaid(text):
    """Each ```mermaid block is drawn in the page by mermaid.js, whose layout beats mmdr's; Quick Look runs it
    (tested 2026-11-16). mmdr's SVG stands in until then, and stays when mermaid.js cannot load."""
    mmdr = shutil.which("mmdr")

    def draw(match):
        source = match.group(1)
        svg = mermaid_svg(mmdr, source) if mmdr else None
        hidden = " hidden" if svg else ""
        fallback = f'<div class="mermaid-fallback">\n{svg}\n</div>\n' if svg else ""
        return (f'\n<div class="mermaid-diagram">\n<pre class="mermaid"{hidden}>{html.escape(source)}</pre>\n'
                f'{fallback}</div>\n')

    return MERMAID_BLOCK.sub(draw, text)


def render_markdown(source):
    text = source.read_text(errors="replace")
    pandoc = shutil.which("pandoc")
    if pandoc:
        run = subprocess.run(
            [pandoc, "--standalone", "--sandbox", "--metadata", f"title={source.name}",
             "--from", "gfm", "--to", "html5"],
            input=draw_mermaid(text).encode(), capture_output=True, timeout=120,
        )
        if run.returncode == 0:
            page = run.stdout
            if b'<pre class="mermaid"' in page:
                page = page.replace(b"</body>", MERMAID_RUN.encode() + b"</body>", 1)
            return page
    return f"<!doctype html><meta charset=utf-8><title>{html.escape(source.name)}</title><pre>{html.escape(text)}</pre>".encode()


DOCUMENTS = {".docx", ".doc", ".odt", ".rtf"}
SHEETS = {".xlsx", ".xlsm", ".xls", ".ods"}
OFFICE_LOCK = threading.Lock()


def cached(source, ext, convert):
    stat = source.stat()
    key = entry_id(source)
    cache = state_dir() / "cache"
    cache.mkdir(parents=True, exist_ok=True)
    out = cache / f"{key}-{stat.st_mtime_ns}-{stat.st_size}.{ext}"
    if out.exists():
        return out.read_bytes()
    body = convert(source)
    if body is None:
        return None
    for stale in cache.glob(f"{key}-*"):
        stale.unlink(missing_ok=True)
    out.write_bytes(body)
    return body


def office_convert(source, target):
    office = shutil.which("soffice") or shutil.which("libreoffice")
    if not office:
        return None
    profile = (state_dir() / "office-profile").as_uri()
    with OFFICE_LOCK, tempfile.TemporaryDirectory() as out:
        run = subprocess.run(
            [office, "--headless", "--norestore", f"-env:UserInstallation={profile}",
             "--convert-to", target, "--outdir", out, str(source)],
            capture_output=True, timeout=120,
        )
        produced = Path(out) / f"{source.stem}.{target.split(':')[0]}"
        if run.returncode != 0 or not produced.is_file():
            return None
        return produced.read_bytes()


def pandoc_docx(source):
    pandoc = shutil.which("pandoc")
    if not pandoc or source.suffix.lower() != ".docx":
        return None
    run = subprocess.run(
        [pandoc, "--standalone", "--sandbox", "--embed-resources", "--metadata", f"title={source.name}",
         "--from", "docx", "--to", "html5", str(source)],
        capture_output=True, timeout=60,
    )
    return run.stdout if run.returncode == 0 else None


def convert(source, view):
    suffix = source.suffix.lower()
    if suffix in (".md", ".markdown"):
        return cached(source, "md.html", render_markdown), "text/html; charset=utf-8"
    if view != ".html":
        return None
    if suffix in SHEETS:
        body = cached(source, "html", lambda s: office_convert(s, "html:HTML (StarCalc):EmbedImages"))
    elif suffix in DOCUMENTS:
        body = cached(source, "html", lambda s: office_convert(s, "html:XHTML Writer File:UTF8")
                      or pandoc_docx(s))
    else:
        body = None
    return None if body is None else (body, "text/html; charset=utf-8")


TYPES = {
    ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    ".xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    ".pptx": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    ".doc": "application/msword",
    ".xls": "application/vnd.ms-excel",
    ".ppt": "application/vnd.ms-powerpoint",
    ".rtf": "application/rtf",
    ".odt": "application/vnd.oasis.opendocument.text",
    ".ods": "application/vnd.oasis.opendocument.spreadsheet",
    ".odp": "application/vnd.oasis.opendocument.presentation",
    ".pages": "application/vnd.apple.pages",
    ".numbers": "application/vnd.apple.numbers",
    ".key": "application/vnd.apple.keynote",
}


def content_type(source):
    kind = TYPES.get(source.suffix.lower()) or mimetypes.guess_type(source.name)[0] or "application/octet-stream"
    if kind.startswith("text/") and "charset" not in kind:
        kind += "; charset=utf-8"
    return kind


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == HEALTH:
            return self.reply(200, b"peek", "text/plain")
        if self.path == VERSION:
            return self.reply(200, json.dumps({**BUILD, "pid": os.getpid()}).encode(), "application/json")
        found = resolve(self.path)
        if found is None:
            return self.reply(404, b"not peeked", "text/plain")
        source, view = found
        converted = convert(source, view)
        if converted is not None:
            return self.reply(200, *converted)
        if view:
            return self.reply(502, f"peek: could not convert {source.name}".encode(), "text/plain")
        return self.reply(200, source.read_bytes(), content_type(source), source.name)

    def reply(self, code, body, kind, name=None):
        self.send_response(code)
        self.send_header("Content-Type", kind)
        if name:
            self.send_header("Content-Disposition", f"inline; filename*=UTF-8''{urllib.parse.quote(name)}")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


def serve():
    state_dir().mkdir(parents=True, exist_ok=True)
    with http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler) as server:
        (state_dir() / "server.pid").write_text(str(os.getpid()))
        server.serve_forever()


def server_up():
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}{HEALTH}", timeout=1) as r:
            return r.read() == b"peek"
    except (urllib.error.URLError, OSError):
        return False


DOWN, SILENT = "down", "silent"


def running_build():
    """What holds PORT: DOWN, SILENT (it did not answer in time), or the build it reports, {} for a server from
    before builds were reported."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}{VERSION}", timeout=1) as r:
            body = r.read()
    except urllib.error.HTTPError:
        return {}
    except (urllib.error.URLError, OSError) as err:
        return DOWN if isinstance(getattr(err, "reason", err), ConnectionRefusedError) else SILENT
    try:
        build = json.loads(body)
    except ValueError:
        return {}
    if isinstance(build, dict) and isinstance(build.get("sha"), str) and isinstance(build.get("mtime_ns"), int):
        return build
    return {}


def current(running):
    """A server is current when it runs these bytes or a newer install: an older session never downgrades it."""
    return (isinstance(running, dict) and bool(running)
            and (running["sha"] == BUILD["sha"] or running["mtime_ns"] >= BUILD["mtime_ns"]))


def port_open():
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", PORT)) == 0


def until(done, seconds):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if done():
            return True
        time.sleep(0.1)
    return done()


def server_pid(build):
    pid = build.get("pid")
    if not isinstance(pid, int):
        try:
            pid = int((state_dir() / "server.pid").read_text())
        except (OSError, ValueError):
            return None
    return pid if pid > 1 else None  # 0 and -1 would signal a whole process group or every process of the user


def replace(build):
    pid = server_pid(build)
    if pid is None:
        raise SystemExit(f"peek: an older server holds port {PORT} and gives no pid; stop it, then run peek again")
    with open(state_dir() / "server.log", "a") as log:
        print(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {SELF} replaces pid {pid} "
              f"({build.get('sha', 'a build from before versions')[:12]})", file=log)
    try:
        os.kill(pid, signal.SIGTERM)
        if not until(lambda: not port_open(), 3):
            os.kill(pid, signal.SIGKILL)
            until(lambda: not port_open(), 2)
    except ProcessLookupError:
        pass
    except PermissionError as err:
        raise SystemExit(f"peek: cannot stop the older server on port {PORT} (pid {pid}): {err}") from err


def launch():
    with open(state_dir() / "server.log", "ab") as log:
        subprocess.Popen([sys.executable, str(SELF), "serve"],
                         stdout=log, stderr=log, stdin=subprocess.DEVNULL, start_new_session=True)


def ensure_server(start=True):
    """Leave a current server on PORT: replace an older release's, and start one when none runs (unless start is
    False, for refresh). A server that answers too slowly is kept, never killed."""
    state_dir().mkdir(parents=True, exist_ok=True)
    with open(state_dir() / "server.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        running = running_build()
        if running == SILENT or (running == DOWN and not start):
            return
        for _ in range(3):
            if current(running):
                return
            if isinstance(running, dict):
                replace(running)
            launch()
            until(lambda: current(running_build()), 5)
            running = running_build()
    raise SystemExit(f"peek: the server did not start; see {state_dir() / 'server.log'}")


def tailnet_base():
    if not shutil.which("tailscale"):
        return None
    status = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True)
    if status.returncode != 0:
        return None
    name = json.loads(status.stdout).get("Self", {}).get("DNSName", "").rstrip(".")
    if not name:
        return None
    routes = subprocess.run(["tailscale", "serve", "status", "--json"], capture_output=True, text=True)
    if f'"{name}:{PORT}"' not in routes.stdout:
        added = subprocess.run(["tailscale", "serve", "--bg", f"--https={PORT}", str(PORT)],
                               capture_output=True, text=True)
        if added.returncode != 0:
            raise SystemExit(f"peek: tailscale serve failed: {added.stderr.strip()}")
    return f"https://{name}:{PORT}"


def base_url():
    base = tailnet_base()
    if base:
        return base
    print("peek: no tailnet route (tailscale missing or not logged in); these URLs open only on this machine",
          file=sys.stderr)
    return f"http://127.0.0.1:{PORT}"


def listing():
    if not files_dir().is_dir():
        return []
    out = []
    for entry in sorted(files_dir().iterdir()):
        for target in entry.iterdir():
            view = view_suffix(Path(os.readlink(target)))
            out.append((f"{entry.name}/{urllib.parse.quote(target.name + view)}", os.readlink(target)))
    return out


def stop():
    pid_file = state_dir() / "server.pid"
    if pid_file.exists():
        try:
            os.kill(int(pid_file.read_text()), signal.SIGTERM)
        except (ProcessLookupError, ValueError):
            pass
        pid_file.unlink()
    if shutil.which("tailscale"):
        subprocess.run(["tailscale", "serve", f"--https={PORT}", "off"], capture_output=True)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    command = argv[0]
    if command == "serve":
        serve()
    elif command == "stop":
        stop()
    elif command == "refresh":
        ensure_server(start=False)
    elif command == "ls":
        base = base_url() if server_up() else f"(stopped) http://127.0.0.1:{PORT}"
        for rel, source in listing():
            print(f"{base}/{rel}\t{source}")
    else:
        rels = [link(p) for p in argv]
        ensure_server()
        base = base_url()
        for rel in rels:
            print(f"{base}/{rel}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
